# Copy to .env (gitignored) and fill in. Never commit real values.

# Kaggle — ONLY needed here for local dataset downloads (data/download.py run on this machine).
# Preferred path: store these in RunPod's Secrets manager instead (console -> Settings -> Secrets),
# reference them by name in the Pod/Endpoint template, and let the training container fetch the
# dataset itself at startup — then this Mac (and this .env) never needs to hold the Kaggle key at all.
KAGGLE_USERNAME=
KAGGLE_KEY=

# RunPod — needed here (wherever the orchestrator runs, i.e. this machine/session) to create/manage
# Pods & Serverless endpoints and invoke them. This is the one credential that can't move to RunPod's
# own Secrets manager, since it's what authenticates calls TO RunPod, not secrets injected INTO a
# RunPod container. RunPod console -> Settings -> API Keys -> Create.
RUNPOD_API_KEY=

# GHCR — where we build+push the image RunPod pulls for the serverless endpoint.
# Public image, so RunPod needs no registry auth to pull it — this is only used locally to push.
# Token: github.com -> avatar -> Settings -> Developer settings -> Personal access tokens ->
# Tokens (classic) -> Generate new token -> scope `write:packages`.
DOCKER_REGISTRY=ghcr.io
GITHUB_USERNAME=
GHCR_TOKEN=
